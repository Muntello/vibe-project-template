# =============================================================================
# {{PROJECT_NAME}} — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# See docs/ENV_VARIABLES.md for detailed descriptions.
#
# RULES:
# - Never commit .env to version control
# - Use ASCII-only comments (no Russian, Chinese, etc.)
# - Generate passwords with: openssl rand -base64 32
# =============================================================================

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_SECRET=                          # REQUIRED. Application secret key
APP_PORT=8000                        # Port the application listens on
APP_HOST=0.0.0.0                     # Bind address
LOG_LEVEL=info                       # debug, info, warning, error, critical
TIME_ZONE=America/New_York           # CRITICAL: must match server and all services

# -----------------------------------------------------------------------------
# Database (Primary)
# -----------------------------------------------------------------------------
DB_ENGINE=                           # postgres, mysql, mongodb, sqlite, etc.
DB_NAME=                             # Database name
DB_USER=                             # Database user
DB_PASSWORD=                         # REQUIRED. 32+ chars for production
DB_HOST=localhost
DB_PORT=5432
# DB_CONNECTION_STRING=              # Alternative: full connection string

# -----------------------------------------------------------------------------
# Database (Secondary) — uncomment if needed
# -----------------------------------------------------------------------------
# SECONDARY_DB_ENGINE=
# SECONDARY_DB_NAME=
# SECONDARY_DB_USER=
# SECONDARY_DB_PASSWORD=
# SECONDARY_DB_HOST=localhost
# SECONDARY_DB_PORT=5432

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_URL=redis://localhost:6379/1   # Redis, Memcached, etc.

# -----------------------------------------------------------------------------
# Message Broker / Task Queue — uncomment if used
# -----------------------------------------------------------------------------
# BROKER_URL=redis://localhost:6379/0
# RESULT_BACKEND=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# External APIs — uncomment and configure as needed
# -----------------------------------------------------------------------------

# Notifications (Telegram, Slack, Email, etc.)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# Payment Providers
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Cloud Services
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT_KEY=           # Minified JSON, single line

# -----------------------------------------------------------------------------
# Internal API Keys
# -----------------------------------------------------------------------------
# API_KEY=                           # 32+ chars. For service-to-service auth
# WEBHOOK_SECRET=                    # For verifying incoming webhooks

# -----------------------------------------------------------------------------
# Diagnostic User (for agent read-only access)
# -----------------------------------------------------------------------------
# DIAG_DB_PASSWORD=                  # Password for diagnostic_user DB role
